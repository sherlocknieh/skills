+static bool isDiagonalAlpha(qreal alpha)
+{
+    const auto absAlpha = std::abs(alpha);
+    return std::abs(absAlpha - 0.25) < 0.05 || std::abs(absAlpha - 0.75) < 0.05;
+}
+
+bool Stroke::directionMatches(const Stroke &other, qreal tolerance) const
+{
+    if (!isStraight() || !other.isStraight() || !isDiagonalAlpha(other.alpha())) {
+        return true;
+    }
+
+    if (tolerance < 0) {
+        tolerance = (g_globalConfig ? g_globalConfig->strokeDirectionTolerance() : 18.0) / 180.0;
+    }
+
+    auto diff = std::abs(alpha() - other.alpha());
+    if (diff > 1.0) {
+        diff = 2.0 - diff;
+    }
+    return diff <= tolerance;
+}
