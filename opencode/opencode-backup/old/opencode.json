{
  "mcp": {
    "servers": {
      "dida365": {
        "type": "remote",
        "url": "https://mcp.dida365.com"
      },
      "browse": {
        "type": "local",
        "command": [
          "/home/who/.local/bin/browse",
          "mcp"
        ],
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  }
}